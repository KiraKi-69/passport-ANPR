# Для запуска без Docker используйте http://localhost:8080.
# В Docker Compose это значение переопределяется на http://label-studio:8080,
# поэтому менять его для контейнерного backend не обязательно.
LABEL_STUDIO_URL=http://localhost:8080

# Токен из Label Studio: Account & Settings -> Personal Access Token.
# В LS 1.23+ это JWT refresh token, backend сам меняет его на access token.
LABEL_STUDIO_API_KEY=

# Label Studio 1.23+ blocks localhost/private addresses for ML backend URLs.
# В docker-compose.yml эти значения также передаются сервису label-studio.
LABEL_STUDIO_ML_BLOCK_LOCAL_IP=false
LABEL_STUDIO_SSRF_PROTECTION_ENABLED=false

# Оставьте пустым: backend найдёт /app/models/best.pt или самый новый
# /app/runs/detect/*/weights/best.pt (каталог ../runs монтируется в /app/runs).
YOLO_MODEL_PATH=

# cpu — CPU-сборка (по умолчанию). Для GPU используйте docker-compose.gpu.yml.
YOLO_DEVICE=cpu
YOLO_CONF=0.25
YOLO_IOU=0.45
YOLO_IMGSZ=640
LOG_LEVEL=INFO
